  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "   <b><color=#00E5FF>Next Step</color></b>\r\n   Moves the 3D scene and
    code highlight together. \n   Answer the challenge to continue.\r\n\r\n   <b><color=#00E5FF>SQL
    injection</color></b>\r\n   Untrusted input changes a query.\r\n\r\n   <b><color=#00E5FF>Parameterized
    query</color></b>\r\n   SQL structure and values are sent separately.\r\n\r\n  
    <b><color=#00E5FF>Least privilege</color></b>\r\n   Only the permissions needed.\r\n\r\n  
    <b><color=#00E5FF>Input validation</color></b>\r\n   Checking that input follows
    the expected rules.\r\n\r\n   <b><color=#00E5FF>Safe error message</color></b>\r\n  
    An error message that does not reveal database \n   details.\r\n\r\n   <b><color=#00E5FF>AR
    mode</color></b>\r\n   Uses your camera to place the 3D lab on a flat\n   surface.
    If the camera is not available, use Preview \n   Mode.\r\n\r\n   <b><color=#00E5FF>Safe
    simulation</color></b>\r\n   All demos are a safe simulation \u2013 no real database."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
